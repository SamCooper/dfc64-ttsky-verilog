    
    // Micro-Jump (uJump) Commands for the Sequencer
    localparam UJMP_STEP       = 3'b000; // micro_pc = micro_pc + 1
    localparam UJMP_DISPATCH_1 = 3'b001; // micro_pc = opcode_mapper(opcode)
    localparam UJMP_DISPATCH_2 = 3'b010; // micro_pc = opcode_mapper(opcode)
    localparam UJMP_DISPATCH_3 = 3'b011; // micro_pc = opcode_mapper(opcode)
    localparam UJMP_FETCH      = 3'b111; // micro_pc = 0x00 (Start over)

    reg [8:0] micro_pc;
    reg [8:0] dispatch_address;

    // =========================================================================
    // 2. THE MICROCODE ROM
    // =========================================================================

    // The ROM: 256 addresses, each holding one micro-word. The word layout (field order,
    // widths) and the contents are generated by gen_control_unit.py.
    reg [MICRO_ROM_WORD_SIZE-1:0] micro_rom [0:511];

    localparam RESET_MICRO_PC  = 9'h07;

    localparam REG_IR    = 4'b0000;
    localparam REG_IR_L  = 4'b0001;
    localparam REG_IR_H  = 4'b0010;
    localparam REG_A     = 4'b0011;
    localparam REG_X     = 4'b0100;
    localparam REG_Y     = 4'b0101;
    localparam REG_SP    = 4'b0110;
    localparam REG_SR    = 4'b0111;
    localparam REG_PCL   = 4'b1000;
    localparam REG_PCH   = 4'b1001;
    localparam REG_ALE   = 4'b1010;
    localparam REG_AHE   = 4'b1011;
    localparam REG_MEM   = 4'b1100;
    localparam REG_ZERO  = 4'b1101;
    localparam REG_ONE   = 4'b1110;

    localparam ALU_OP_ADD = 4'b0000;
    localparam ALU_OP_SUB = 4'b0001;
    localparam ALU_OP_ADC = 4'b0010;
    localparam ALU_OP_SBC = 4'b0011;
    localparam ALU_OP_CMP = 4'b0100;
    localparam ALU_OP_AND = 4'b0101;
    localparam ALU_OP_EOR = 4'b0110;
    localparam ALU_OP_OR  = 4'b0111;
    localparam ALU_OP_ASL = 4'b1000;
    localparam ALU_OP_LSR = 4'b1001;
    localparam ALU_OP_ROL = 4'b1010;
    localparam ALU_OP_ROR = 4'b1011;

    initial begin
        micro_pc = 9'h0;
        // --- 0x00: INSTRUCTION FETCH ROUTINE ---
        // Every CPU cycle starts here. We read RAM, increment PC, and decode.
